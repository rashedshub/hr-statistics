rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can VIEW the dashboard data (public link).
    // Only signed-in users (your admins) can create/edit/delete it.
    match /sites/{siteId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /reports/{periodId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
